[run]
source = src
omit = 
    src/views/*
    src/main.py
    src/views/components/*
    */tests/*
    */__pycache__/*
    */build/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2
