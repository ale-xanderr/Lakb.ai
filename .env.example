# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Google Maps Static API
MAPS_STATIC_API_KEY=your_maps_static_api_key

# Supabase (for authentication and data persistence)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# OAuth Redirect URLs
# Desktop/Web development (localhost)
REDIRECT_URL=http://localhost:8550/oauth_callback

# Android redirect URL (custom URL scheme for deep linking)
ANDROID_REDIRECT_URL=lakbai://oauth_callback

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta 

# Calendarific (Public holidays )
CALENDARIFIC_API_KEY=your_calendarific_api_key
CALENDARIFIC_BASE_URL=https://calendarific.com/api/v2

# OpenAQ (Air quality for outdoor/nature trips)
OPENAQ_API_KEY=your_openaq_api_key
OPENAQ_BASE_URL=https://api.openaq.org/v3

# OPENWEATHER
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather